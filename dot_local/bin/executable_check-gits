#!/usr/bin/env bash

# Finds all git repositories underneath the given directories and prints a
# status word and the path of any repository that looks like it isn't fully
# committed or synced:
#  - EMPTY: no commit checked out (usually a repo with no commits yet)
#  - MODIFIED: tracked files with uncommitted changes
#  - UNTRACKED: untracked files that are not ignored
#  - NO-REMOTE: no remotes configured
# Only the first applicable status is printed for each repository.

set -e

# Runs in a subshell so the cd doesn't leak and a return ends this repo only.
check_repo() (
    cd "$1" || return 0
    git rev-parse HEAD >/dev/null 2>&1        || { echo "EMPTY $PWD"; return 0; }
    git diff-index --quiet HEAD --            || { echo "MODIFIED $PWD"; return 0; }
    [ -z "$(git status --porcelain | grep '^??')" ] || { echo "UNTRACKED $PWD"; return 0; }
    [ "$(git remote | wc -l)" -gt 0 ]         || { echo "NO-REMOTE $PWD"; return 0; }
)

find "$@" -type d -name .git -prune -print0 |
    while IFS= read -r -d '' dir; do
        check_repo "${dir%/.git}"
    done
