#!/bin/sh

# Launch reusable configurations for named tmux sessions. A session file in
# $TMUXSTART_DIR (default ~/.tmuxstart) is sourced with the helpers below in
# scope; with no file, a plain session of that name is created.

sessiondir=${TMUXSTART_DIR:-$HOME/.tmuxstart}
ts_name=$(basename "$0")

usage() {
    printf 'Usage: %s [OPTIONS] SESSION\n\n' "$ts_name"
    printf 'Launch reusable configurations for named tmux sessions.\n\n'
    printf 'Options:\n\n'
    printf -- '-h Print help menu\n'
    printf -- '-l List all available session files\n'
    printf -- '-v Print %s version number\n' "$ts_name"
}

[ $# -lt 1 ] && usage && exit 1

_print_version() {
    echo "${ts_name} 0.2.0"
}

while getopts ':hlv' option; do
    case "${option}" in
        h) usage ; exit 0 ;;
        l) \ls "$sessiondir" ; exit 0 ;;
        v) _print_version ; exit 0 ;;
        *) echo "Invalid option" ; usage ; exit 1 ;;
    esac
done

# Helpers for session files. $session is the session name; if a session file
# sets $path before calling new_session, the session starts there.
new_session() {
    if [ "$path" ]; then
        tmux new-session -d -s "$session" -c "$path" "$@"
    else
        tmux new-session -d -s "$session" "$@"
    fi
}
new_window() {
    if [ "$path" ]; then
        tmux new-window -d -t "$session" -c "$path" "$@"
    else
        tmux new-window -d -t "$session" "$@"
    fi
}
rename() { tmux rename-window -t "$session:$@"; }
kill_window() { tmux kill-window -t "$session:$@"; }
select_pane() { tmux select-pane -t "$session:$@"; }
select_window() { tmux select-window -t "$session:$@"; }
select_layout() { tmux select-layout -t "$session:$@"; }
send_keys() { tmux send-keys -t "$session:$@"; }
send_line() { send_keys "$@" "Enter"; }
set_env() { tmux set-environment -t "$session" "$@"; }
split() { tmux split-window -t "$session:$@"; }
swap() { tmux swap-pane -t "$session:$@"; }

session=$1
TMUX_OLD=$TMUX
TMUX=
if ! tmux has-session -t "$session" 2>/dev/null; then
    if [ -f "$sessiondir/$session" ]; then
        . "$sessiondir/$session"
    else
        tmux new-session -d -s "$session"
    fi
fi
if [ -z "$TMUX_OLD" ]; then
    tmux attach-session -t "$session"
else
    tmux switch-client -t "$session"
fi
TMUX=$TMUX_OLD
